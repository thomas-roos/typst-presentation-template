{
  "version": "2.0.0",
  "tasks": [
    {
      // Rebuild deck.pdf on every save. Open it in an editor
      // tab (PDF extension) next to the source: the fallback where Tinymist's
      // live preview does not work, e.g. Codespaces in the browser
      // (https://github.com/Myriad-Dreamin/tinymist/issues/1691).
      "label": "Watch deck PDF",
      "type": "shell",
      "command": "typst watch --font-path fonts deck.typ deck.pdf",
      "options": { "cwd": "${workspaceFolder}/typst" },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": { "runOn": "folderOpen" }
    }
  ]
}
